DATABASE_URL="postgresql://orkestra:orkestra@localhost:5432/orkestra?schema=public"
JWT_SECRET="change-me-in-production"
# Access tokens are short-lived by design (spec: target 15m) — the
# refresh token (httpOnly cookie, see SessionService) carries the
# long-lived trust now, not this one.
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
NODE_ENV="development"

# AI provider — leave GEMINI_API_KEY unset to run on the built-in Mock provider
AI_PROVIDER="mock"        # "mock" | "gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-pro"

# Storage — leave STORAGE_PROVIDER=local to write to apps/api/uploads/
STORAGE_PROVIDER="local"   # "local" | "gcs"
GCS_BUCKET=""

# ClickHouse — leave unset to run analytics purely off Postgres
CLICKHOUSE_URL=""

# ADK Agent Service — required only when AI_PROVIDER=adk
ADK_AGENT_URL="http://localhost:8081"
