    "@nestjs/passport": "^10.0.3",
    "@nestjs/config": "^3.2.3",
    "@nestjs/event-emitter": "^2.0.4",
    "@prisma/client": "^5.19.0",
    "@google/generative-ai": "^0.19.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "bcryptjs": "^2.4.3",
